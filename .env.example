# Separate credentials for the osu! Wrapped subpage. Existing OSU_CLIENT_*
# variables belong to the Social page's playtime integration; preserve them.
WRAPPED_OSU_CLIENT_ID=
WRAPPED_OSU_CLIENT_SECRET=
WRAPPED_OSU_REDIRECT_URI=https://ronaldonater.com/api/osu-wrapped/auth/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WRAPPED_SESSION_SECRET=

# Optional Neon Free club community tracking. Backend only; never use VITE_ prefixes.
WRAPPED_DATABASE_URL=
# Generate a stable 32+ character secret; keep the same value across deployments.
WRAPPED_CLUB_TRACKING_SECRET=
